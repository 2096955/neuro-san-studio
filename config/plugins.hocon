# Fork plugin defaults — copied from neuro_san_studio/templates/plugins.hocon by `ns init`.
# Override here without editing the package template.
#
# Observability: enable ONE primary tracer (Arize for production MAA, Phoenix or Langfuse for local experiments).

plugins = [
    {
        class = neuro_san_studio.plugins.arize.arize_plugin.ArizePlugin
        enabled = false
        enabled = ${?ARIZE_ENABLED}
    }
    {
        class = neuro_san_studio.plugins.phoenix.phoenix_plugin.PhoenixPlugin
        enabled = false
        enabled = ${?PHOENIX_ENABLED}
    }
    {
        class = neuro_san_studio.plugins.langfuse.langfuse_plugin.LangfusePlugin
        enabled = false
        enabled = ${?LANGFUSE_ENABLED}
    }
    {
        class = neuro_san_studio.plugins.log_bridge.process_log_bridge_plugin.ProcessLogBridgePlugin
        enabled = true
        enabled = ${?LOGBRIDGE_ENABLED}
    }
]
