{
    # This file is NOT an agent network HOCON.
    # It defines a set of key-value pairs for substitution, typically used in agent network HOCON files.
    # Each key can be referenced in agent configs using the ${key} syntax.
    # Do not define agents or tools directly here—this file only provides reusable values.

    aaosa_instructions = """ When you receive an inquiry, you will:
1. If the inquiry is clearly outside your area of expertise, reply that you're not relevant and stop — do not call any down-chain agents.
2. If there is a chance you're relevant, call ONLY the down-chain agent(s) whose role plausibly covers the inquiry to determine if they can answer all or part of it. Do NOT call agents whose role is clearly unrelated, and never call all of them by default — route by relevance.
3. Once all relevant down-chain agents have responded, either:
   - Analyze their response and compile your final response. No need to include non-relevant agents. In doubt, ask for clarification.
   - Follow up with your down-chain agents if needed, as many times as needed
   - If an action is needed, ask the most relevant down-chain agent to fulfill the inquiry.
4. Return the final response to the caller.
You may, in turn, be called by other agents in the system and have to act as a down-chain agent to them.
""",

    aaosa_call = {
        description = "Depending on the mode, returns a natural language string in response.",
        parameters = {
            type = "object",
            properties = {
                inquiry = {
                    "type": "string",
                    "description": "The inquiry"
                },
                mode = {
                    type = "string",
                    description =
"""'Determine' to ask the agent if the inquiry belongs to it, in its entirety or in part.
'Follow up' to continue the conversation with the agent.
'Fulfill' to ask the agent to fulfill the inquiry, if it can.
"""
                },
            },
            required = [
                "inquiry",
                "mode"
            ]
        }
    },

    aaosa_command = """Return a json block with the following fields:
 {
    "Name": <your name>,
    "Inquiry": <the inquiry>,
    "Mode": <Determine | Follow up | Fulfill>,
    "Relevant": <Yes | No>,
    "Strength": <number between 1 and 10 representing how certain you are in your claim>,
    "Claim:" <All | Partial | None>,
    "Requirements": <None | list of requirements>,
    "Response": <Your response>
}
"""

    # --- Intent-routing front-man (this fork) ---
    # Replaces the blind "always call every down-chain agent" behaviour. The front-man classifies
    # intent, tells the user how it's routing (which specialists and why), and calls ONLY the
    # relevant specialist(s). Use this for a network's entry-point agent instead of aaosa_instructions.
    aaosa_router_instructions = """

You are the coordinator and entry point for a team of specialist agents. Each specialist's tool description states exactly what it does.

For every user message:
1. ALWAYS begin your reply with one short italicised line stating the logical bounce: the intent you detected and which specialist(s) you are consulting and why — or that you'll answer it yourself and why. Format: "_Routing: <intent> → consulting <agent(s)> because <reason>._" (or "_Answering directly: <reason>._"). Then continue with the actual answer. Never omit this line.
2. If the message is a greeting, small talk, thanks, or anything OUTSIDE every specialist's stated specialty, answer it yourself, briefly. Do NOT call any agent.
3. Otherwise call ONLY the specialist(s) whose stated specialty matches the intent. Never call a specialist whose specialty is unrelated, and never call all of them "just in case" — that wastes time and tokens. If two specialists plausibly overlap for the request, consult both (or ask the user to clarify) — but still never call the unrelated ones.
4. If you are missing information needed to route or answer (a time, a location, an id), ask the user for it instead of guessing or calling agents blindly.
5. Compile a concise final answer from the specialist(s) you consulted, using only what they return plus the user's input — not your own outside knowledge.
"""

    # Parameters schema for a specialist tool call. Pair this with a MEANINGFUL per-agent
    # `function.description` so the front-man can route by capability (do not use the generic aaosa_call).
    aaosa_call_params = {
        type = "object",
        properties = {
            inquiry = {
                "type": "string",
                "description": "The inquiry to send to this specialist."
            },
            mode = {
                type = "string",
                description = "'Determine' to check relevance, 'Fulfill' to act on it, 'Follow up' to continue."
            },
        },
        required = [ "inquiry", "mode" ]
    }
}
