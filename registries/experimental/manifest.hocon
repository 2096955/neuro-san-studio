{
    # Sub-manifest for experimental / research agent networks.
    # Included from registries/manifest.hocon.

    "experimental/six_thinking_hats.hocon": true,

    # Off until specific apps are run / configured:
    # apps/cruse/interface_flask.py
    "experimental/cruse_agent.hocon": false,
    # apps/conscious_assistant/interface_flask.py
    "experimental/conscious_agent.hocon": false,
    # apps/log_analyzer/log_analyzer.py
    "experimental/log_analysis_agents.hocon": false,
    # Upstream-adopted research networks (disabled by default)
    "experimental/copy_cat.hocon": false,
    "experimental/mdap_decomposer.hocon": false,
    "experimental/kwik_agents.hocon": false,
}
