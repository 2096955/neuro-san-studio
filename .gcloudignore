# Speed up `gcloud builds submit` uploads: exclude paths the Dockerfile.cloudrun
# build does not need. Keep: requirements.cloudrun.txt, app.py, templates/,
# static/, registries/, coded_tools/, toolbox/, api_adapter/, frontend/ (the
# Dockerfile.cloudrun has a `frontend-builder` stage that runs `npm ci` +
# `vite build` against this tree), Dockerfile.cloudrun.
.git/
**/__pycache__/
*.pyc
*.pyo
# frontend/node_modules and frontend/dist are regenerated by the builder stage;
# keep frontend/ source itself.
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
logs/
attached_assets/
docs/
.ruff_cache/
.genkit/
.cursor/
.claude/
.playwright-mcp/
.superpowers/
.local/
*.png
