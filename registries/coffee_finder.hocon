include "registries/aaosa_basic.hocon"

llm_config {
    class = "ollama"
    model_name = "qwen3.6:35b-a3b"
    reasoning = false
}

tools = [
    # Entry point — an intent ROUTER, not a blind broadcaster. It classifies the request, tells the
    # user which specialist(s) it is consulting and why, and calls ONLY those.
    {
        name = "CoffeeFinder"
        function {
            description = """Finds coffee at any time of day."""
        }
        instructions =
"""
You help users find a place to get coffee. Your specialists (call only the relevant one(s)):
- CoffeeShop  : Bob's Coffee Shop — COFFEE, open 7am-6pm.
- FastFoodChain: Henry's Fast Food — COFFEE, open 5:30am-12am.
- GasStation  : Joe's Gas Station — COFFEE, any time.
- LiquorStore : Jack's Liquor Store — ALCOHOL only (NOT coffee), 21+.

Be succinct. Use only what your specialists return, not your own knowledge of specific places.
Never consult the LiquorStore for a coffee request.
""" ${aaosa_router_instructions}
        tools = ["CoffeeShop", "FastFoodChain", "GasStation", "LiquorStore"]
        "structure_formats": "json"
    }
    {
        name = "CoffeeShop",
        function = {
            description = "Bob's Coffee Shop: serves COFFEE at one location, open 7am-6pm. Consult for coffee availability/hours here."
            parameters = ${aaosa_call_params}
        }
        instructions =
"""
You are Bob's Coffee Shop. One location, open 7am-6pm (closed otherwise); you need the time of day to answer.
If the inquiry is not about getting coffee, reply that you're not relevant and stop — do not do any other work.
""" ${aaosa_instructions},
        command = ${aaosa_command}
    }
    {
        name = "FastFoodChain",
        function = {
            description = "Henry's Fast Food: serves COFFEE at one location, open 5:30am-12am. Consult for coffee availability/hours here."
            parameters = ${aaosa_call_params}
        }
        instructions =
"""
You are Henry's Fast Food. One location, open 5:30am-12am (closed otherwise); you need the time of day to answer.
If the inquiry is not about getting coffee, reply that you're not relevant and stop — do not do any other work.
""" ${aaosa_instructions}
        command = ${aaosa_command}
    }
    {
        name = "GasStation"
        function = {
            description = "Joe's Gas Station: serves COFFEE at one location, any time of day. Consult for coffee available 24/7."
            parameters = ${aaosa_call_params}
        }
        instructions =
"""
You are Joe's Gas Station. One location, coffee available any time.
If the inquiry is not about getting coffee, reply that you're not relevant and stop — do not do any other work.
""" ${aaosa_instructions},
        command = ${aaosa_command}
    }
    {
        name = "LiquorStore"
        function = {
            description = "Jack's Liquor Store: sells ALCOHOL only (NOT coffee), any time, to ages 21+. Consult only for alcohol."
            parameters = ${aaosa_call_params}
        }
        instructions =
"""
You are Jack's Liquor Store. One location, you sell alcohol any time to ages 21+.
You do NOT sell coffee. If the inquiry is not about buying alcohol, reply that you're not relevant and stop.
""" ${aaosa_instructions},
        command = ${aaosa_command}
    }
]

# >>> category-tag (managed by tag_registries.py) <<<
metadata { tags = ["Basic"] }
