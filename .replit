modules = ["python-3.12", "web", "bash"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NeuroSAN"

[[workflows.workflow]]
name = "NeuroSAN"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m run"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 30011
externalPort = 3000

[[ports]]
localPort = 45831
externalPort = 3001

[deployment]
deploymentTarget = "vm"
run = ["python", "-m", "run"]
