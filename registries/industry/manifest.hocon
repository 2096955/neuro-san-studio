    "industry/insurance_underwriting_agents.hocon": true,
    # Deprecated by upstream; superseded by insurance_underwriting_agents
    "industry/insurance_agents.hocon": false,
    "industry/keybank.hocon": false,

    # Retail / CPG
    "industry/cpg_agents.hocon": true,
    "industry/retail_ops_and_customer_service.hocon": true,
    "industry/macys.hocon": true,
    "industry/carmax.hocon": true,
    "industry/consumer_decision_assistant.hocon": true,
    # Sub-networks used by consumer_decision_assistant
    "industry/airbnb.hocon": true,
    "industry/booking.hocon": true,
    "industry/expedia.hocon": true,

    # Telco
    "industry/telco_network_support.hocon": true,
    "industry/telco_network_orchestration.hocon": false,

    # Travel / airline
    "industry/airline_policy.hocon": true,
    "industry/airline_policy_web_search.hocon": false,

    # Healthcare — therapy_vignette_supervisors (sidebar tag = Healthcare via tag_registries.py)
