{
    # Refer to this document for neuro-san specifications for the agent manifest.hocon file
    # that is used as configuration for neuro-san servers
    # https://github.com/cognizant-ai-lab/neuro-san/blob/main/docs/manifest_hocon_reference.md
    #
    # The fork organizes registries into subdirs (basic/, tools/, industry/, experimental/,
    # generated/), each with its own sub-manifest. This root manifest pulls them in and
    # adds fork-only top-level entries (AEEN, designer family).

    # Group sub-manifests
    include "registries/basic/manifest.hocon",
    include "registries/tools/manifest.hocon",
    include "registries/industry/manifest.hocon",
    include "registries/experimental/manifest.hocon",
    # Runtime-generated networks (agent_network_designer writes here)
    include "registries/generated/manifest.hocon",

    #
    # Agent network designer family (kept at root — designer-internal support networks)
    #
    "agent_network_designer.hocon": true,
    "agent_network_editor.hocon": {
        # Support network for agent_network_designer; serve but don't expose publicly
        "serve": true,
        "public": false
    },
    "agent_network_instructions_editor.hocon": {
        # Support network for agent_network_designer; serve but don't expose publicly
        "serve": true,
        "public": false
    },
    "agent_network_query_generator.hocon": {
        # Support network for agent_network_designer; serve but don't expose publicly
        "serve": true,
        "public": false
    },
    "agent_network_test_generator.hocon": false,
    # End-to-end designer demo (calls designer + html_creator + nsflow + gmail). Off by default —
    # requires Selenium/WebDriver, Gmail API credentials, and a separately-launched nsflow service.
    "agent_network_architect.hocon": false,

    #
    # Healthcare — fork-only (Agentic Evidence Exchange Network PoC)
    # Sidebar category: Healthcare. AAOSA front-man Evidence_Exchange_Coordinator.
    # See registries/agentic_evidence_exchange.hocon and coded_tools/aeen/.
    #
    "agentic_evidence_exchange.hocon": true,
}
