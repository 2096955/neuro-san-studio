{
    # >>> category-tag (managed by tag_registries.py) <<<
    metadata { tags = ["Tools"] }

    # Web-search backing provider (toolbox-layer implementation), chosen at LOAD TIME.
    # Default = brave_search for local runs (no DuckDuckGo locally). Datacenter/cloud deploys set
    # WEB_SEARCH_TOOLBOX=tavily_search (DDG blocks datacenter egress) — NO registry rewrite needed.
    # This is the single, legitimate provider-swap point; callers only ever reference /web_search.
    # NOTE: if set, WEB_SEARCH_TOOLBOX must name a real toolbox (ddgs_search | tavily_search | brave_search);
    # an empty or unknown value is NOT fail-safe — it disables web search (fails at call time).
    web_search_toolbox = "brave_search"
    web_search_toolbox = ${?WEB_SEARCH_TOOLBOX}

    "llm_config": {
        "fallbacks": [
            {"class": "ollama", "model_name": "qwen3.6:35b-a3b", "reasoning": false},
            {"class": "ollama", "model_name": "qwen3.6:27b"}
        ]
    },
    "tools": [
        # This first agent definition is regarded as the "Front Man", which
        # does all the talking to the outside world/client.
        #
        # Some disqualifications from being a front man:
        #   1) Cannot use a CodedTool "class" definition
        #   2) Cannot use a Tool "toolbox" definition
        #
        # Besides the first agent being the front man, these tool definitions
        # do not have to be in any particular order. How they are linked and
        # call each other is defined within their own specs.
        # This could be a graph, potentially even with cycles.
        {
            "name": "searcher",

            "function": {
                "description": "Assist caller with searching an url.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "user_inquiry": {
                            "type": "string",
                            "description": """
                            An inquiry from a user.
                            """
                        },
                    },
                    "required": ["user_inquiry"]
                }
            },

            "instructions": """
Use your tool to respond to the inquiry.
""",
            "tools": ["website_search"]
        },
        {
            "name": "website_search",
            # Backing provider selected at load time (default ddgs_search; cloud sets WEB_SEARCH_TOOLBOX).
            "toolbox": ${web_search_toolbox},
            "args": {
                # --- Optional Arguments ---
                # max_results is honored by ddgs_search/tavily_search; brave_search honors count.
                "max_results": 5,
                "count": 5
            }
        },
    ]
}
