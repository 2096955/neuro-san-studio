# Cloud Run Dockerfile for Neuro SAN Studio Flask App
#
# Multi-stage build:
#   Stage 1 (builder)  — node 20-alpine; npm ci + vite build of frontend/
#   Stage 2 (runtime)  — python 3.11-slim Flask app; copies dist/ from builder

# ---- Stage 1: build the React Flow frontend ----
FROM node:20-alpine AS frontend-builder
WORKDIR /build
# Copy lockfile first so npm ci is cacheable across source-only edits
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
# Now copy the rest of the source and build
COPY frontend/ ./
# Empty VITE_API_BASE_URL -> production bundle uses same-origin relative URLs
# (the Flask app at runtime serves both the static React assets and the API on
# the same port, so the bundle should call /api/* not http://localhost:8000/api/*).
ENV VITE_API_BASE_URL=""
RUN npm run build && ls -la dist

# ---- Stage 2: Python runtime ----
FROM python:3.11-slim
WORKDIR /app

# System deps for Python wheels
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cloud Run image uses a trimmed requirements file (no nsflow / web-client, which
# pin neuro_san<0.6 and are not imported by the Flask app).
COPY requirements.cloudrun.txt .
RUN pip install --no-cache-dir -r requirements.cloudrun.txt

# Application code
COPY app.py .
COPY templates/ ./templates/
COPY static/ ./static/
COPY registries/ ./registries/
# Use the cloud-specific manifest (prod's served set minus ddgs_search, plus the
# current web_search/Tavily design). Local dev keeps its own Ollama-only
# manifest.hocon in the repo; only the image is overridden.
RUN cp registries/manifest.cloudrun.hocon registries/manifest.hocon
COPY coded_tools/ ./coded_tools/
COPY toolbox/ ./toolbox/
# Repo-root toolbox/ holds only a README; the actual toolbox tool definitions
# (tavily_search -> coded_tools.tavily_search, etc.) live in the neuro_san_studio
# package. Bring the info file so AGENT_TOOLBOX_INFO_FILE (set below) resolves and
# web_search can load its Tavily-backed tool.
COPY neuro_san_studio/toolbox/toolbox_info.hocon ./toolbox/toolbox_info.hocon
# Ship the shared manifest_loader helper so app.py's list_networks() can
# import `neuro_san_studio.utils.manifest_loader.load_public_networks` —
# the single RegistryManifestRestorer wrapper used across entrypoints.
COPY neuro_san_studio/__init__.py ./neuro_san_studio/__init__.py
COPY neuro_san_studio/utils/ ./neuro_san_studio/utils/
# api_adapter provides the Next.js-compatible /api/v1/* blueprint that app.py
# registers when present. Also contains synthetic_endpoints.py — the
# stubbed governance/RAI endpoints (synthetic=true) the React Flow UI consumes.
COPY api_adapter/ ./api_adapter/

# Pull in the production-built React Flow frontend from the builder stage.
# Mounted under frontend_dist/ so app.py can route /v2 -> index.html and
# /v2/assets/* -> static files alongside the legacy /static/ tree.
COPY --from=frontend-builder /build/dist ./frontend_dist

# Build-time manifest smoke test: refuse to ship an image whose manifest
# resolves to fewer public networks than expected. This catches the class of
# bug Phase 4 introduced — flat-path entries silently failing under the new
# grouped-include layout — at build time instead of post-deploy. Threshold
# starts at 20 (current count is 36); raise as the cloud surface grows.
RUN AGENT_MANIFEST_FILE=registries/manifest.hocon python -c "\
from neuro_san.internals.graph.persistence.registry_manifest_restorer import RegistryManifestRestorer; \
r = RegistryManifestRestorer(manifest_files='registries/manifest.hocon').restore(); \
n = len(r.get('public', {})); \
print(f'manifest smoke: {n} public networks'); \
assert n >= 20, f'manifest resolved only {n} public networks (threshold 20) — refusing to build'"

RUN mkdir -p logs

EXPOSE 8080
ENV PORT=8080
# Toolbox tool definitions (tavily/brave/rag/etc.) live in the repo's
# toolbox/toolbox_info.hocon. The studio uses DirectAgentSession directly (not
# neuro-san's `ns run` launcher), so without this env var only the package-default
# toolbox (requests/datetime) loads and any "toolbox" tool (e.g. web_search ->
# tavily_search) is undefined at call time. Path matches WORKDIR /app.
ENV AGENT_TOOLBOX_INFO_FILE=/app/toolbox/toolbox_info.hocon

CMD ["python", "app.py"]
